// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 予約枠（スロット）
model Slot {
  id        String   @id @default(cuid())
  startTime DateTime
  endTime   DateTime
  status    String   @default("OPEN") // OPEN, FULL, CANCELLED
  bookings  Booking[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startTime])
  @@index([status])
}

// 予約
model Booking {
  id        String   @id @default(cuid())
  slotId    String
  slot      Slot     @relation(fields: [slotId], references: [id], onDelete: Cascade)

  // 顧客情報
  name      String
  email     String
  company   String?  // 会社名（任意）
  message   String   @db.Text // 相談内容

  // ステータス
  status    String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED

  cancelToken     String?   @unique
  privacyAgreedAt DateTime?
  reminderSentAt  DateTime?
  cancelledAt     DateTime?
  clientHash      String?   // 不正予約対策：通信元IPを復元できない形にしたもの

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slotId])
  @@index([email])
  @@index([status])
  @@index([clientHash, createdAt])
}

// 管理画面のメールログイン用リンク（トークンはハッシュだけを保存）
model AdminLoginToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
}

// お問い合わせ（/contact から）
model Inquiry {
  id              String   @id @default(cuid())
  name            String
  email           String
  company         String?
  message         String   @db.Text
  status          String   @default("NEW") // NEW, DONE
  privacyAgreedAt DateTime
  clientHash      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
  @@index([clientHash, createdAt])
}
